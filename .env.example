# RealityLens — Master Environment Configuration Example
# Never commit active production secrets to source control.

# Application Core
APP_NAME=RealityLens
API_V1_PREFIX=/api/v1
SECRET_KEY=generate-a-strong-random-256-bit-key-using-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL + pgvector or local SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./realitylens.db
# DATABASE_URL=postgresql+asyncpg://realitylens_user:secure_password@localhost:5432/realitylens_db
DATABASE_USER=realitylens_user
DATABASE_PASSWORD=secure_password
REDIS_URL=redis://localhost:6379/0

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=15
MIN_BLUR_THRESHOLD=35.0

# Multimodal AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# Computer Vision & OCR
VISION_API_KEY=
OCR_API_KEY=
TESSERACT_CMD=tesseract

# Speech & Audio (Kannada, Hindi, English)
STT_API_KEY=
TTS_API_KEY=
TRANSLATION_API_KEY=

# Object Storage (S3 / MinIO / Cloudflare R2)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=realitylens-captures

# Search & Vector Index
SEARCH_ENDPOINT=http://localhost:9200

# Push Notifications (Firebase Cloud Messaging)
FCM_CONFIG=

# Agent Integrations
MAPS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
WEATHER_API_KEY=
